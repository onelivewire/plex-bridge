# Copy to .env and replace with the Docker host's reserved LAN IPv4 address.
# Documentation address only: this example is not a reachable deployment.
BRIDGE_HOST=192.0.2.10
BRIDGE_VERSION=0.1.0-beta.4

# Optional absolute host directory for /data; omit to use a Docker named volume.
# Pre-create a bind directory owned by 10001:10001 with mode 700.
# BRIDGE_DATA_PATH=/mnt/user/appdata/plex-bridge/data
